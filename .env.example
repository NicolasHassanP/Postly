# Copiá este archivo como .env y completá los valores reales.
# El .env NO se sube a git. start-n8n.ps1 lo carga y arranca n8n.

# PAGE ACCESS TOKEN de Meta (no expira). Lo obtenés con scripts/get-meta-token.ps1
META_ACCESS_TOKEN=PEGAR_PAGE_TOKEN_ACA

# App de Meta (Meta for Developers)
META_APP_ID=PEGAR_APP_ID_ACA
META_APP_SECRET=PEGAR_APP_SECRET_ACA

# ID de la cuenta de Instagram Business
IG_BUSINESS_ID=17841435642266301

N8N_BASE_URL=
N8N_API_KEY_LOCAL=

# URL pública estable (tu dominio de ngrok)
WEBHOOK_URL=https://TU-DOMINIO.ngrok-free.dev/
