      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const state = $('Callback OAuth').first().json.query.state;\nconst tl = $('Token largo').first().json;\nconst longToken = tl.access_token;\nconst expiresIn = tl.expires_in || 5184000;\nconst page = $('Page Token').first().json || {};\nconst igAcc = page.instagram_business_account && page.instagram_business_account.id;\nconst expiresAt = new Date(Date.now() + expiresIn * 1000).toISOString();\nreturn [{ json: {\n  TelegramUserID: String(state || ''),\n  AccessToken: page.access_token || longToken,\n  ExpiresAt: expiresAt,\n  IGAccountID: igAcc || $env.IG_BUSINESS_ID || '',\n  PageID: page.id || $env.META_PAGE_ID || '',\n  PageName: page.name || ''\n} }];"
      }
    },
