    {
      "parameters": {
        "jsCode": "// HU2 — Preparar fila para Usuarios. Token cifrado (AES-256-GCM) antes de guardar.\nconst crypto = require('crypto');\nconst ENC_KEY = Buffer.from($env.POSTLY_ENC_KEY, 'hex'); // 32 bytes\nfunction encrypt(plain) {\n  if (!plain) return plain;\n  const iv = crypto.randomBytes(12);\n  const cipher = crypto.createCipheriv('aes-256-gcm', ENC_KEY, iv);\n  const ct = Buffer.concat([cipher.update(String(plain), 'utf8'), cipher.final()]);\n  const tag = cipher.getAuthTag();\n  return 'enc:' + Buffer.concat([iv, tag, ct]).toString('base64');\n}\n\nconst state = $('Callback OAuth').first().json.query.state;\nconst tl = $('Token largo').first().json;\nconst longToken = tl.access_token;\nconst expiresIn = tl.expires_in || 5184000;\nconst page = $('Page Token').first().json || {};\nconst igAcc = page.instagram_business_account && page.instagram_business_account.id;\nconst expiresAt = new Date(Date.now() + expiresIn * 1000).toISOString();\nreturn [{ json: {\n  TelegramUserID: String(state || ''),\n  AccessToken: encrypt(page.access_token || longToken),\n  ExpiresAt: expiresAt,\n  IGAccountID: igAcc || $env.IG_BUSINESS_ID || '',\n  PageID: page.id || $env.META_PAGE_ID || '',\n  PageName: page.name || ''\n} }];"
      },
