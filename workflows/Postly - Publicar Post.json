    {
      "id": "dec",
      "name": "Descifrar credenciales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst KEY = Buffer.from($env.POSTLY_ENC_KEY, 'hex');\nfunction decrypt(val) {\n  if (!val || typeof val !== 'string' || !val.startsWith('enc:')) return val;\n  const raw = Buffer.from(val.slice(4), 'base64');\n  const iv  = raw.subarray(0, 12);\n  const tag = raw.subarray(12, 28);\n  const ct  = raw.subarray(28);\n  const d = crypto.createDecipheriv('aes-256-gcm', KEY, iv);\n  d.setAuthTag(tag);\n  return Buffer.concat([d.update(ct), d.final()]).toString('utf8');\n}\nreturn $input.all().map(item => ({ json: { ...item.json, AccessToken: decrypt(item.json.AccessToken) } }));"
      }
    },
