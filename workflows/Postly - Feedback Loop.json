    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sheetItems = $('Get row(s) in sheet').all();\nconst result = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const sheetData = sheetItems[i]?.json || {};\n\n  // Saltar filas ya procesadas o sin PostID\n  if (sheetData.Metricas_Enviadas === 'Si') continue;\n  if (!sheetData.PostID_IG) continue;\n\n  // Extraer métricas del response de Meta\n  const data = item.json.data || [];\n  const getMetric = (name) => {\n    const found = data.find(d => d.name === name);\n    return found?.values?.[0]?.value ?? 'N/D';\n  };\n\n  // Formatear fecha legible\n  const fechaRaw = sheetData.Timestamp || '';\n  let fechaFormateada = 'Sin fecha';\n  if (fechaRaw) {\n    fechaFormateada = new Date(fechaRaw).toLocaleDateString('es-AR', {\n      weekday: 'long',\n      day: '2-digit',\n      month: 'long',\n      year: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit'\n    });\n  }\n\n  result.push({\n    json: {\n      ...sheetData,\n      impressions: getMetric('impressions'),\n      reach: getMetric('reach'),\n      likes: sheetData.Likes || 'N/D',\n      fechaFormateada,\n      row_number: Number(sheetData.row_number)  // forzar número explícitamente\n    }\n  });\n}\n\nreturn result;"
      },
