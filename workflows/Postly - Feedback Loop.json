    {
      "name": "Traer métricas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// HU14 — junta posts publicados + usuarias, descifra el token por-usuaria y trae like/comments de Meta\nconst crypto = require('crypto');\nconst KEY = Buffer.from($env.POSTLY_ENC_KEY, 'hex');\nfunction decrypt(val) {\n  if (!val || typeof val !== 'string' || !val.startsWith('enc:')) return val;\n  const raw = Buffer.from(val.slice(4), 'base64');\n  const iv = raw.subarray(0, 12);\n  const tag = raw.subarray(12, 28);\n  const ct = raw.subarray(28);\n  const d = crypto.createDecipheriv('aes-256-gcm', KEY, iv);\n  d.setAuthTag(tag);\n  return Buffer.concat([d.update(ct), d.final()]).toString('utf8');\n}\n\n// mapa TelegramUserID -> token descifrado\nconst tokenByUser = {};\nfor (const u of $('Leer usuarios').all().map(i => i.json)) {\n  const uid = String(u.TelegramUserID == null ? '' : u.TelegramUserID);\n  if (uid) tokenByUser[uid] = decrypt(u.AccessToken);\n}\n\nconst out = [];\nfor (const p of $('Leer publicados').all().map(i => i.json)) {\n  if (!p || !p.PostID_IG || !p.row_number) continue;\n  const uid = String(p.UserID == null ? '' : p.UserID);\n  const token = tokenByUser[uid];\n  if (!token) continue;\n\n  let Likes = 'N/D', Comments = 'N/D';\n  try {\n    const resp = await this.helpers.httpRequest({\n      method: 'GET',\n      url: 'https://graph.facebook.com/v19.0/' + p.PostID_IG,\n      qs: { fields: 'like_count,comments_count', access_token: token },\n      json: true\n    });\n    Likes = (resp && resp.like_count != null) ? resp.like_count : 0;\n    Comments = (resp && resp.comments_count != null) ? resp.comments_count : 0;\n  } catch (e) {\n    // si Meta falla para este post, dejamos N/D y seguimos con los demás\n  }\n  out.push({ json: { row_number: Number(p.row_number), Likes, Comments } });\n}\nreturn out;\n"
      }
    },
