    {
      "name": "Descifrar credenciales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst KEY = Buffer.from($env.POSTLY_ENC_KEY, 'hex');\nfunction decrypt(val){ if(!val||typeof val!=='string'||!val.startsWith('enc:')) return val; const raw=Buffer.from(val.slice(4),'base64'); const iv=raw.subarray(0,12),tag=raw.subarray(12,28),ct=raw.subarray(28); const d=crypto.createDecipheriv('aes-256-gcm',KEY,iv); d.setAuthTag(tag); return Buffer.concat([d.update(ct),d.final()]).toString('utf8'); }\nreturn $input.all().map(it=>({ json: { ...it.json, AccessToken: decrypt(it.json.AccessToken) } }));"
      },
      "id": "df8b26ce-fe79-4cc3-a7ab-dddfa24367ff"
    },
    {
      "name": "Expandir URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "// Publicar Carrusel — un item por URL (split por salto de línea o coma)\nconst trig = $('PC Trigger').first().json;\nconst list = String(trig.Carousel_URLs || '').split(/[\\r\\n,]+/).map(s => s.trim()).filter(Boolean);\nreturn list.map((u, i) => ({ json: { url: u, idx: i } }));\n"
      },
      "id": "7038655b-95a9-46df-bcfb-db0111c47180"
    },
