        "jsCode": "// Publicar Carrusel — junta los ids de contenedores hijos en CSV\nconst ids = $input.all().map(it => it.json.id).filter(Boolean);\nreturn [{ json: { children: ids.join(','), n: ids.length } }];\n"
      },
      "id": "03f128e8-ba6e-433c-b679-3260fa2a5ac2"
