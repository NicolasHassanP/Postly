    {
      "name": "Filtrar vencidos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const now=Date.now();\nconst out=[];\nfor(const it of $input.all()){\n  const r=it.json;\n  if(!r.Fecha_Programada) continue;\n  const t=new Date(r.Fecha_Programada).getTime();\n  if(isFinite(t) && t<=now){\n    out.push({ json: { UserID:r.UserID, ImageURL:r.ImageURL, Caption:r.Copy_Final, row_number:r.row_number } });\n  }\n}\nreturn out;"
      }
    },
